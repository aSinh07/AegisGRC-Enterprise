# Scanner worker configuration. Copy to .env.worker on the worker VM only (never commit it).
# The system of record's public hostname (through Cloudflare Tunnel).
AEGIS_URL=https://aegis.example.com
# Must match one entry of AEGIS_WORKER_KEYS on the server: "<id>:<secret>".
AEGIS_WORKER_ID=gce-worker-1
AEGIS_WORKER_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Cloudflare Access service token for the worker API path (Zero Trust → Access → Service Auth).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Optional: restrict which tools this worker leases (comma-separated: http,nmap,nuclei,wapiti,zap,sqlmap).
AEGIS_WORKER_TOOLS=
AEGIS_WORKER_POLL_MS=5000
ZAP_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SCAN_TIMEOUT_MS=90000
MAX_OUTPUT_BYTES=1048576

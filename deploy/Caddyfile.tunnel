# Caddy behind Cloudflare Tunnel. TLS terminates at the Cloudflare edge; cloudflared reaches
# Caddy over the internal Docker network only, so Caddy listens on plain :80 with no published port.
{
    auto_https off
    admin off
}
:80 {
    # Cloudflare already enforced Access (identity) before traffic entered the tunnel.
    request_body {
        max_size 25MB
    }
    reverse_proxy aegis:8080 {
        header_up X-Forwarded-Proto https
    }
    header {
        -Server
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
}

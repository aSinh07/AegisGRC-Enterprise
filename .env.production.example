PORT=8080
NODE_ENV=production
COOKIE_SECURE=true
PGSSL=disable

POSTGRES_USER=aegis
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
POSTGRES_DB=aegis
# Least-privilege database access (recommended). db:init migrates as the owner (POSTGRES_USER)
# via MIGRATION_DATABASE_URL and provisions AEGIS_DB_RUNTIME_ROLE; the app connects with
# DATABASE_URL as that non-owner role, so evidence/audit triggers are a hard control.
# Legacy single-role mode: omit MIGRATION_DATABASE_URL/AEGIS_DB_RUNTIME_* and point DATABASE_URL at the owner.
MIGRATION_DATABASE_URL=postgres://aegis:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/aegis
AEGIS_DB_RUNTIME_ROLE=aegis_app
AEGIS_DB_RUNTIME_PASSWORD=REPLACE_WITH_AT_LEAST_24_RANDOM_CHARACTERS
DATABASE_URL=postgres://aegis_app:REPLACE_WITH_URL_ENCODED_RUNTIME_PASSWORD@postgres:5432/aegis
AEGIS_REQUIRE_NON_OWNER_DB_ROLE=true

ASSESSMENT_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
EVIDENCE_HMAC_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
REPORT_SIGNING_KEY=replace-with-at-least-32-random-characters
GRC_AUTOMATION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
TOTP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SCAN_TIMEOUT_MS=90000
MAX_OUTPUT_BYTES=1048576
DATA_DIR=/tmp/aegis-data

DB_POOL_MAX=20
EXTERNAL_SCANNER_TIMEOUT_MS=180000
EXTERNAL_SCANNER_MAX_BYTES=8388608
SCANNER_JOB_LEASE_SECONDS=900
SCANNER_JOB_MAX_ATTEMPTS=2
ASSESSMENT_AUTHORIZATIONS_PER_HOUR=20

# Architecture gap closure: OWASP ZAP (required full-assessment engine) and TLS edge hostname
ZAP_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
AEGIS_DOMAIN=aegisgrc-security.duckdns.org
FULL_ASSESSMENT_MAX_MS=7200000

# Open-gap closure
# Target authorization: "enforce" (production default) requires DNS/HTTP ownership proof plus a
# second-person approval before any scan. "attest" is the legacy checkbox and is NOT recommended.
TARGET_AUTHORIZATION_MODE=enforce
TARGET_AUTHORIZATION_TTL_DAYS=90
# HMAC-signed audit-chain checkpoints (uses EVIDENCE_HMAC_KEY)
AUDIT_CHECKPOINT_INTERVAL_MS=600000
